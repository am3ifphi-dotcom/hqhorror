{
  "name": "hqhorror",
  "version": "1.0.0",
  "description": "しずかな家 — a 2D atmospheric horror game (HTML5 / Canvas2D / WebGL post FX)",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "assets:fetch": "bash tools/fetch_lpc.sh",
    "assets:build": "python3 tools/build_char.py && python3 tools/build_atlas.py && python3 tools/build_audio.py",
    "smoke": "node tools/smoke.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/am3ifphi-dotcom/hqhorror.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.11",
    "jsdom": "^30.1.3",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "@fontsource/shippori-mincho": "^5.3.0"
  }
}
